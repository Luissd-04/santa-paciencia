---
import Calcada from './Calcada.astro';
import Icon from './Icon.astro';
// Chamada final: faixa escura com a calçada a desvanecer em cima.
interface Props { titulo?: string; texto?: string; fase?: number }
const {
  titulo = 'A próxima época pode ser a mais calma de sempre.',
  texto = 'Estamos a abrir aos poucos, com acompanhamento pessoal na configuração. Peça já o seu lugar.',
  fase = 3.1,
} = Astro.props;
---
<section class="dark final" aria-labelledby="fim">
  <Calcada fase={fase} topo />
  <div class="in">
    <h2 class="h2" id="fim">{titulo}</h2>
    <p class="sub">{texto}</p>
    <div class="ctas"><a class="btn p" href="/acesso-antecipado/">Pedir acesso antecipado <Icon nome="arrow" class="go" /></a><a class="btn s" href="/precos/">Ver preços</a></div>
  </div>
</section>
