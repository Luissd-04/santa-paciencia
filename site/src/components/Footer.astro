---
import Logo from './Logo.astro';
import { marca, funcionalidades, urlFuncionalidade } from '../config/brand';
import { t, type Lang } from '../i18n';
import { url, urlPerfil } from '../i18n/rotas';
// Rodapé: ligações, línguas (a outra leva à página equivalente, `outra`) e avisos legais.
interface Props { lang?: Lang; /** Endereço da página equivalente na outra língua. */ outra: string }
const { lang = 'pt', outra } = Astro.props;
const d = t(lang).comum;
const r = d.rod;
const ano = new Date().getFullYear();
// Rótulos curtos das 8 funcionalidades (os endereços vêm de brand.ts).
const funcs = funcionalidades.map((f) => [urlFuncionalidade(f.slug, lang), d.rotulosRodape[f.slug] ?? f.slug]);
---
<footer class="foot"><div class="in">
  <div class="cols">
    <div><Logo lang={lang} /><p style="margin:0;max-width:320px">{r.descricao}</p></div>
    <div><h4>{r.funcionalidades}</h4><ul>{funcs.map(([href, rotulo]) => <li><a href={href}>{rotulo}</a></li>)}<li><a href={url(lang, 'funcionalidades')}>{r.verTodas}</a></li></ul></div>
    <div><h4>{r.paraQuem}</h4><ul><li><a href={urlPerfil('proprietarios', lang)}>{r.proprietarios}</a></li><li><a href={urlPerfil('gestores', lang)}>{r.gestores}</a></li><li><a href={urlPerfil('empresas-de-gestao', lang)}>{r.empresas}</a></li></ul></div>
    <div><h4>{r.saberMais}</h4><ul><li><a href={url(lang, 'precos')}>{r.precos}</a></li><li><a href={url(lang, 'acesso')}>{r.acesso}</a></li><li><a href={url(lang, 'perguntas')}>{r.perguntas}</a></li><li><a href={url(lang, 'guias')}>{r.guias}</a></li><li><a href={url(lang, 'sobre')}>{r.sobre}</a></li><li><a href={url(lang, 'contacto')}>{r.contacto}</a></li></ul></div>
  </div>
  <div class="legal"><span>© {ano} {marca.nome} · {r.feitoEm}</span><span><a href={url(lang, 'privacidade')}>{r.privacidade}</a> · <a href={url(lang, 'termos')}>{r.termos}</a> · <a href="https://www.livroreclamacoes.pt/" rel="noopener" target="_blank">{r.livro}</a></span><span class="langs" role="group" aria-label={r.idiomaAria}><span aria-current="true">{r.linguaAtual}</span> · <a href={outra} hreflang={d.outraLingua.codigo} lang={d.outraLingua.codigo}>{d.outraLingua.nome}</a></span></div>
</div></footer>
