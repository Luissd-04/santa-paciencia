---
import Icon from './Icon.astro';
import { marca } from '../config/brand';
import { t, type Lang } from '../i18n';
import { url } from '../i18n/rotas';
// Formulário de acesso antecipado. Valida no browser. Com CONTACT_ENDPOINT envia POST JSON
// ({nome, email, telefone, alojamentos, canais, assunto, mensagem, idioma}); sem endpoint abre o programa de email.
// Sem JavaScript, o formulário cai para um mailto: simples.
// Props (a página de contacto reutiliza este formulário): `assunto` acrescenta o campo «Assunto» (opcional);
// `titulo`, `botao`, `mensagem`, `nota` e `modo` mudam os textos (por omissão, os de i18n `comum.form`);
// `modo` é o assunto por omissão do email. As mensagens do script vão em `data-t` (uma por língua).
interface Props { lang?: Lang; assunto?: boolean; titulo?: string; botao?: string; mensagem?: string; modo?: string; nota?: string }
const { lang = 'pt', assunto = false } = Astro.props;
const f = t(lang).comum.form;
const { titulo = f.titulo, botao = f.botao, mensagem = f.mensagem, modo = f.modo, nota = f.nota } = Astro.props;
---
<form class="form" novalidate method="post" action={`mailto:${marca.email}`} enctype="text/plain"
  data-endpoint={marca.contactEndpoint} data-email={marca.email} data-marca={marca.nome} data-modo={modo} data-t={JSON.stringify(f.js)}>
  <h2>{titulo}</h2>
  <div class="two">
    <div class="fld"><label for="nome">{f.nome}</label><input id="nome" name="nome" autocomplete="name" required aria-describedby="erro-nome"><span class="err" id="erro-nome" role="alert"></span></div>
    <div class="fld"><label for="tel">{f.telemovel} <small>{f.opcional}</small></label><input id="tel" name="telefone" type="tel" autocomplete="tel" inputmode="tel"></div>
  </div>
  <div class="fld"><label for="email">{f.email}</label><input id="email" name="email" type="email" autocomplete="email" required aria-describedby="erro-email"><span class="err" id="erro-email" role="alert"></span></div>
  {assunto && <div class="fld"><label for="assunto">{f.assunto} <small>{f.opcional}</small></label><input id="assunto" name="assunto" autocomplete="off"></div>}
  <div class="fld"><label for="casas">{f.casas}</label><select id="casas" name="alojamentos">{f.casasOpcoes.map((o, i) => <option selected={i === 2}>{o}</option>)}</select></div>
  <fieldset class="fld"><legend>{f.onde}</legend><div class="chips">{f.canais.map((c, i) => <label><input type="checkbox" name="canais" value={c} checked={i < 2}> {c}</label>)}</div></fieldset>
  <div class="fld"><label for="msg">{mensagem} <small>{f.opcional}</small></label><textarea id="msg" name="mensagem" rows="3"></textarea></div>
  <div class="hp" aria-hidden="true"><label>{f.naoPreencher} <input name="website" tabindex="-1" autocomplete="off"></label></div>
  <p class="falha" role="alert" data-falha></p>
  <button class="btn p" type="submit">{botao} <Icon nome="arrow" class="go" /></button>
  <p class="note">{nota} <a href={url(lang, 'privacidade')}>{f.privacidade}</a>.</p>
  <div class="done" role="status"><span class="ok"><Icon nome="check" forte /></span><h2 tabindex="-1">{f.feitoTitulo}</h2><p style="margin:0;color:var(--cinza)" data-feito>{f.feitoTexto}</p><a class="btn s" href={url(lang, 'perguntas')} style="color:var(--basalto)">{f.feitoBotao}</a></div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('form.form');
  if (form) {
    const email = form.dataset.email || '';
    const marca = form.dataset.marca || '';
    const modo = form.dataset.modo || '';
    // Mensagens e rótulos da língua da página (atributo data-t, ver o frontmatter).
    const m: Record<string, string> = JSON.parse(form.dataset.t || '{}');
    const falha = form.querySelector<HTMLElement>('[data-falha]')!;
    const botao = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    const regras: Record<string, (v: string) => string> = {
      nome: (v) => (v.trim().length < 2 ? m.nomeInvalido : ''),
      email: (v) => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) ? '' : m.emailInvalido),
    };
    const validar = (campo: HTMLInputElement) => {
      const msg = regras[campo.name]?.(campo.value) ?? '';
      campo.setAttribute('aria-invalid', msg ? 'true' : 'false');
      const alvo = document.getElementById(`erro-${campo.name}`);
      if (alvo) alvo.textContent = msg;
      return !msg;
    };
    const campos = (): HTMLInputElement[] => [...form.elements].filter((c): c is HTMLInputElement => c instanceof HTMLInputElement && c.name in regras);
    form.addEventListener('focusout', (e) => { const t = e.target as HTMLInputElement; if (t.name in regras) validar(t); });
    form.addEventListener('input', (e) => { const t = e.target as HTMLInputElement; if (t.getAttribute?.('aria-invalid') === 'true') validar(t); });

    const concluir = (texto?: string) => {
      form.classList.add('sent');
      const p = form.querySelector<HTMLElement>('[data-feito]');
      if (texto && p) p.textContent = texto;
      form.querySelector<HTMLElement>('.done h2')?.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      falha.textContent = '';
      const endpoint = form.dataset.endpoint || '';
      const invalidos = campos().filter((c) => !validar(c));
      if (invalidos.length) { invalidos[0].focus(); return; }

      const fd = new FormData(form);
      if (fd.get('website')) return; // armadilha para robôs
      const dados = {
        nome: String(fd.get('nome') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        telefone: String(fd.get('telefone') || '').trim(),
        alojamentos: String(fd.get('alojamentos') || ''),
        canais: fd.getAll('canais').map(String),
        assunto: String(fd.get('assunto') || '').trim(),
        mensagem: String(fd.get('mensagem') || '').trim(),
        idioma: document.documentElement.lang,
      };

      if (!endpoint) {
        const corpo = `${dados.assunto ? `${m.assunto}: ${dados.assunto}\n` : ''}${m.nome}: ${dados.nome}\n${m.email}: ${dados.email}\n${m.telefone}: ${dados.telefone || '—'}\n${m.alojamentos}: ${dados.alojamentos}\n${m.anunciaEm}: ${dados.canais.join(', ') || '—'}\n\n${dados.mensagem}`;
        location.href = `mailto:${email}?subject=${encodeURIComponent(`${dados.assunto || modo} · ${marca}`)}&body=${encodeURIComponent(corpo)}`;
        concluir(m.emailAberto);
        return;
      }

      botao.disabled = true;
      const rotulo = botao.innerHTML;
      botao.textContent = m.aEnviar;
      try {
        const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(dados) });
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        concluir();
      } catch {
        falha.innerHTML = '';
        falha.append(m.falhaEnvio);
        const a = document.createElement('a');
        a.href = `mailto:${email}`; a.textContent = email;
        falha.append(a, '.');
      } finally {
        botao.disabled = false;
        botao.innerHTML = rotulo;
      }
    });
  }
</script>
