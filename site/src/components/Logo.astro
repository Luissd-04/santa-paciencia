---
import { marca } from '../config/brand';
import { url, type Lang } from '../i18n/rotas';
// O logótipo leva ao início da língua da página.
interface Props { lang?: Lang }
const { lang = 'pt' } = Astro.props;
---
<a class="logo" href={url(lang, 'inicio')}><svg viewBox="0 0 26 26" aria-hidden="true"><rect width="26" height="26" rx="6" fill="#843424"/><path d="M4 16.5c3-3.2 6-3.2 9 0s6 3.2 9 0" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/><path d="M4 10.5c3-3.2 6-3.2 9 0s6 3.2 9 0" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" opacity=".5"/></svg>{marca.nome}</a>
