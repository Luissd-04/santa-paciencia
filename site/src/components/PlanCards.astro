---
import Icon from './Icon.astro';
import { eur, fmt, planosDe, t, type Lang } from '../i18n';
import { url } from '../i18n/rotas';
// Os três planos (valores em src/config/brand.ts, marcados POR CONFIRMAR; texto em i18n).
interface Props { lang?: Lang }
const { lang = 'pt' } = Astro.props;
const d = t(lang).comum;
---
<div class="plans">
  {planosDe(lang).map((p) => (
    <article class={p.destaque ? 'plan feat' : 'plan'}>
      <h2>{p.nome}{p.destaque && <span class="pill">{d.planCards.maisEscolhido}</span>}</h2>
      <p class="for">{p.para}</p>
      <div class="price"><b data-m={eur(lang, p.mensal)} data-y={eur(lang, p.anual)}>{eur(lang, p.mensal)}</b><span class="per">{d.planCards.mes}</span></div>
      <a class={`btn ${p.destaque ? 'p' : 's'}`} href={url(lang, 'acesso')}>{fmt(d.planCards.experimentar, { nome: p.nome })}</a>
      <ul>{p.inclui.map((x) => <li><Icon nome="check" forte /><span>{x}</span></li>)}</ul>
      <div class="lim">{p.limites}</div>
    </article>
  ))}
</div>
