---
import { t, type Lang } from '../../i18n';
// Cartão de um talão a ser lido: o papel e os campos preenchidos. Dados de exemplo.
interface Props { lang?: Lang }
const { lang = 'pt' } = Astro.props;
const d = t(lang).comum.visuais.talao;
---
<div class="vcard" aria-hidden="true">
  <div class="hd"><b>{d.titulo}</b><span class="pill">{d.pill}</span></div>
  <div class="talao">
    <span class="t">{d.loja}</span>
    {d.linhas.map(([nome, valor]) => <p><span>{nome}</span><span>{valor}</span></p>)}
    <p><span>{d.data}</span><span><mark>{d.total}</mark></span></p>
  </div>
  <div class="lido">
    <div class="fld"><label>{d.campos.data}</label><div>{d.valores.data}</div></div>
    <div class="fld"><label>{d.campos.valor}</label><div>{d.valores.valor}</div></div>
    <div class="fld w"><label>{d.campos.fornecedor}</label><div>{d.valores.fornecedor}<span>{d.valores.lido}</span></div></div>
    <div class="fld"><label>{d.campos.casa}</label><div>{d.valores.casa}</div></div>
    <div class="fld"><label>{d.campos.categoria}</label><div>{d.valores.categoria}</div></div>
  </div>
  <a class="btn p" href="#como">{d.botao}</a>
</div>
