---
import Icon from '../Icon.astro';
// Telemóvel com o formulário de pré-check-in do hóspede, com dados de exemplo.
---
<div class="phone" aria-hidden="true" style="position:relative;top:0"><div class="phone-in">
  <div class="ph"><b>Pré-check-in</b><span>Casa da Eira</span></div>
  <div class="fld"><label>Titular da reserva</label><div>Helena Lopes<span>PT</span></div></div>
  <div class="fld"><label>Documento</label><div>Cartão de cidadão<span>Preenchido</span></div></div>
  <div class="fld"><label>Acompanhantes</label>
    <div class="chips" style="margin-top:0;border:0;padding:0;background:none"><span class="on">Rui</span><span class="on">Inês</span><span class="on">Tomás</span><span>+ Adicionar</span></div></div>
  <div class="fld"><label>Hora de chegada prevista</label><div>16:30<span>9 nov</span></div></div>
  <div class="agree"><i><Icon nome="check" forte /></i><span>Li a informação de privacidade e aceito o tratamento dos dados.</span></div>
  <div class="sendbtn">Enviar dados</div>
</div></div>
