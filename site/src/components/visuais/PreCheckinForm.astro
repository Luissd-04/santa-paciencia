---
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n';
// Telemóvel com o formulário de pré-check-in do hóspede, com dados de exemplo.
interface Props { lang?: Lang }
const { lang = 'pt' } = Astro.props;
const d = t(lang).comum.visuais.precheckin;
---
<div class="phone" aria-hidden="true" style="position:relative;top:0"><div class="phone-in">
  <div class="ph"><b>{d.titulo}</b><span>{d.sub}</span></div>
  <div class="fld"><label>{d.titular}</label><div>{d.nome}<span>{d.pais}</span></div></div>
  <div class="fld"><label>{d.documento}</label><div>{d.docValor}<span>{d.preenchido}</span></div></div>
  <div class="fld"><label>{d.acompanhantes}</label>
    <div class="chips" style="margin-top:0;border:0;padding:0;background:none">{d.pessoas.map((p) => <span class="on">{p}</span>)}<span>{d.adicionar}</span></div></div>
  <div class="fld"><label>{d.hora}</label><div>{d.horaValor}<span>{d.data}</span></div></div>
  <div class="agree"><i><Icon nome="check" forte /></i><span>{d.privacidade}</span></div>
  <div class="sendbtn">{d.enviar}</div>
</div></div>
