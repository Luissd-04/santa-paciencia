---
import { t, type Lang } from '../../i18n';
// Pré-visualização de um email de chegada e as sete línguas. Dados de exemplo.
interface Props { lang?: Lang }
const { lang = 'pt' } = Astro.props;
const d = t(lang).comum.visuais.email;
const linguas = ['PT', 'EN', 'FR', 'ES', 'DE', 'IT', 'NL'];
---
<div class="vcard" aria-hidden="true">
  <div class="hd"><b>{d.titulo}</b><span class="pill">{d.pill}</span></div>
  <div class="mail"><small>{d.de}</small><small>{d.para}</small><b>{d.assunto}</b><p>{d.corpo}</p></div>
  <div class="chips">{linguas.map((l, i) => <span class={i === 0 ? 'on' : ''}>{l}</span>)}</div>
</div>
