---
import Icon from '../Icon.astro';
// Cartão «Escolha o quarto» da página de reservas, com dados de exemplo.
---
<div class="vcard" aria-hidden="true">
  <div class="hd"><b>Escolha o quarto</b><span class="pill">2 hóspedes</span></div>
  <div class="dates"><div>Entrada<b>9 nov</b></div><div>Saída<b>12 nov</b></div></div>
  <div class="opt sel"><span class="ph2"><Icon nome="key" /></span><div><b>Quarto Azul</b><small>Casal · pequeno-almoço</small></div><span class="v">60 €<small>por noite</small></span></div>
  <div class="opt"><span class="ph2"><Icon nome="key" /></span><div><b>Loft do Rio</b><small>Até 4 hóspedes · cozinha</small></div><span class="v">95 €<small>por noite</small></span></div>
  <div class="vtot"><span>Total · 3 noites</span><b>180,00 €</b></div>
  <a class="btn p" href="#como">Reservar e pagar o sinal</a>
</div>
