---
import Icon from '../Icon.astro';
import { t, type Lang } from '../../i18n';
// Cartão «Escolha o quarto» da página de reservas, com dados de exemplo.
interface Props { lang?: Lang }
const { lang = 'pt' } = Astro.props;
const d = t(lang).comum.visuais.quarto;
---
<div class="vcard" aria-hidden="true">
  <div class="hd"><b>{d.titulo}</b><span class="pill">{d.pill}</span></div>
  <div class="dates"><div>{d.entrada}<b>{d.d1}</b></div><div>{d.saida}<b>{d.d2}</b></div></div>
  {d.opcoes.map((o) => <div class={o.sel ? 'opt sel' : 'opt'}><span class="ph2"><Icon nome="key" /></span><div><b>{o.nome}</b><small>{o.sub}</small></div><span class="v">{o.preco}<small>{o.por}</small></span></div>)}
  <div class="vtot"><span>{d.total}</span><b>{d.totalValor}</b></div>
  <a class="btn p" href="#como">{d.botao}</a>
</div>
