---
import { t, type Lang } from '../../i18n';
// Cartão «Relatório · junho» com números e barras por casa. Dados de exemplo.
interface Props { lang?: Lang }
const { lang = 'pt' } = Astro.props;
const d = t(lang).comum.visuais.relatorio;
---
<div class="vcard" aria-hidden="true">
  <div class="hd"><b>{d.titulo}</b><span class="pill">{d.pill}</span></div>
  <div class="kpis">{d.kpis.map(([k, v]) => <div><small>{k}</small><b>{v}</b></div>)}</div>
  <div class="vh">{d.porCasa}</div>
  <div class="bars" style="margin-top:10px">
    {d.casas.map(([n, v, w, c]) => <div class="br"><span>{n}</span><div class="tr"><i class={c} style={`width:${w}%`}></i></div><span class="n">{v}</span></div>)}
  </div>
</div>
