---
import { t, type Lang } from '../i18n';
// O calendário do topo do início (ilustração em HTML, com dados de exemplo).
// Os `--d` são os atrasos da animação de entrada das barras.
interface Props { lang?: Lang }
const { lang = 'pt' } = Astro.props;
const d = t(lang).comum.visuais.calendario;
---
<div class="app" aria-hidden="true">
  <div class="app-top">{d.titulo} <span>{d.mes}</span></div>
  <div class="row days"><b></b>{d.dias.map((dia, i) => <span class={i === 2 ? 't' : undefined}>{dia}<br>{9 + i}</span>)}</div>
  <div class="row"><b>Casa da Eira</b><span class="bar a-grow" style="grid-column:2/5;--d:0ms">Marta S.</span><span class="bar b2 a-grow" style="grid-column:6/9;--d:0ms">{d.lopes}</span></div>
  <div class="row"><b>Quarto Azul</b><span class="bar b3 a-grow" style="grid-column:3/6;--d:90ms">J. Almeida</span></div>
  <div class="row"><b>Loft do Rio</b><span class="bar a-grow" style="grid-column:4/8;--d:160ms">{d.anaPedro}</span></div>
  <div class="row"><b>Monte Branco</b><span class="bar b2 a-grow" style="grid-column:2/4;--d:210ms">R. Costa</span><span class="bar a-grow" style="grid-column:5/8;--d:210ms">Sofia M.</span></div>
</div>
