---
// O calendário do topo do início (ilustração em HTML, com dados de exemplo).
// Os `--d` são os atrasos da animação de entrada das barras.
---
<div class="app" aria-hidden="true">
  <div class="app-top">Calendário <span>novembro</span></div>
  <div class="row days"><b></b><span>seg<br>9</span><span>ter<br>10</span><span class="t">qua<br>11</span><span>qui<br>12</span><span>sex<br>13</span><span>sáb<br>14</span><span>dom<br>15</span></div>
  <div class="row"><b>Casa da Eira</b><span class="bar a-grow" style="grid-column:2/5;--d:0ms">Marta S.</span><span class="bar b2 a-grow" style="grid-column:6/9;--d:0ms">Família Lopes</span></div>
  <div class="row"><b>Quarto Azul</b><span class="bar b3 a-grow" style="grid-column:3/6;--d:90ms">J. Almeida</span></div>
  <div class="row"><b>Loft do Rio</b><span class="bar a-grow" style="grid-column:4/8;--d:160ms">Ana e Pedro</span></div>
  <div class="row"><b>Monte Branco</b><span class="bar b2 a-grow" style="grid-column:2/4;--d:210ms">R. Costa</span><span class="bar a-grow" style="grid-column:5/8;--d:210ms">Sofia M.</span></div>
</div>
