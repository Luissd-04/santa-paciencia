---
import Icon from './Icon.astro';
import { eur, fmt, planosDe, t, type Lang } from '../i18n';
import { url } from '../i18n/rotas';
// Cartões dos planos recomendados para um perfil. Valores de src/config/brand.ts (POR CONFIRMAR).
interface Props { ids: string[]; lang?: Lang }
const { ids, lang = 'pt' } = Astro.props;
const d = t(lang).comum.reco;
const todos = planosDe(lang);
const escolhidos = ids.map((id) => todos.find((p) => p.id === id)).filter((p) => !!p);
---
<div class="reco" style={`--n:${escolhidos.length}`}>
  {escolhidos.map((p) => (
    <article>
      <h3>{p!.nome}</h3>
      <p class="for">{p!.para}</p>
      <div class="pr">{eur(lang, p!.mensal)} <span>{d.porMes}</span></div>
      <small>{fmt(d.anual, { preco: eur(lang, p!.anual) })}</small>
      <ul>{p!.inclui.map((x) => <li><Icon nome="check" forte /><span>{x}</span></li>)}</ul>
      <div class="lim">{p!.limites}</div>
    </article>
  ))}
</div>
<p class="reco-nota">{d.notaAntes}<a href={url(lang, 'precos')}>{d.notaLink}</a>.</p>
