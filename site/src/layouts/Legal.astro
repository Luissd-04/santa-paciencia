---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import { t, type Lang } from '../i18n';
import { url } from '../i18n/rotas';

// Páginas legais (privacidade, termos): topo escuro, aviso de texto provisório bem visível e texto corrido.
interface Props { titulo: string; descricao: string; h1: string; atualizado: string; fase?: number; lang?: Lang }
const { titulo, descricao, h1, atualizado, fase = 1.0, lang = 'pt' } = Astro.props;
const d = t(lang).comum;
---
<Base titulo={titulo} descricao={descricao} lang={lang}>
  <PageHero h1={h1} fase={fase} lang={lang} caminho={[{ rotulo: d.inicio, href: url(lang, 'inicio') }, { rotulo: h1 }]} />
  <section class="sec" style="padding-top:72px">
    <div class="in">
      <div class="prose">
        <p class="nota" role="note"><strong>{d.legal.notaTitulo}</strong> {d.legal.nota}</p>
        <slot />
        <p style="color:var(--cinza);font-size:15px">{d.legal.atualizacao}: {atualizado}.</p>
      </div>
    </div>
  </section>
</Base>
