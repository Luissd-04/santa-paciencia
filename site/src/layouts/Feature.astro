---
import Base from './Base.astro';
import Calcada from '../components/Calcada.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon, { type NomeIcone } from '../components/Icon.astro';
import Tile from '../components/Tile.astro';
import Faq from '../components/Faq.astro';
import '../styles/visuais.css';
import { marca } from '../config/brand';
import { htmlLang, t, type Lang } from '../i18n';
import { url } from '../i18n/rotas';

// Modelo de página de funcionalidade: topo com caminho, H1, lede e visual; «três passos»;
// benefícios com visual; funcionalidades relacionadas; chamada final.
interface Props {
  /** Título e descrição do <head>. */
  titulo: string;
  descricao: string;
  /** Nome da funcionalidade, para o caminho («Pagamentos online»). */
  nome: string;
  h1: string;
  lede: string;
  /** Fase da calçada do topo. */
  fase?: number;
  /** Os três passos. */
  passos: { titulo: string; texto: string }[];
  tituloPassos: string;
  /** Benefícios: título da secção e lista (negrito + texto). */
  tituloBeneficios: string;
  beneficios: { titulo: string; texto: string }[];
  /** Funcionalidades relacionadas (ladrilhos de ligação). */
  relacionadas: { icone: NomeIcone; rotulo: string; href: string }[];
  /** Perguntas frequentes (com JSON-LD FAQPage). */
  perguntas?: [string, string][];
  /** `perguntas`: os «passos» são perguntas grandes, sem números (página de relatórios). */
  passosComoPerguntas?: boolean;
  imagem?: string;
  lang?: Lang;
}
const { lang = 'pt', titulo, descricao, nome, h1, lede, fase = 0.8, passos, tituloPassos, tituloBeneficios, beneficios, relacionadas, imagem, perguntas = [], passosComoPerguntas = false } = Astro.props;
const d = t(lang).comum;
const caminho = [
  { rotulo: d.inicio, href: url(lang, 'inicio') },
  { rotulo: d.cab.funcionalidades, href: url(lang, 'funcionalidades') },
  { rotulo: nome },
];
const software = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: marca.nome, applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web', inLanguage: htmlLang[lang], url: marca.siteUrl + url(lang, 'inicio'), description: descricao,
};
---
<Base titulo={titulo} descricao={descricao} atual="funcionalidades" imagem={imagem} jsonld={[software]} lang={lang}>
  <section class="dark play">
    <Calcada fase={fase} />
    <div class="in hero">
      <div>
        <Breadcrumbs itens={caminho} lang={lang} />
        <h1>{h1}</h1>
        <p class="lede">{lede}</p>
        <div class="ctas"><a class="btn p" href={url(lang, 'acesso')}>{d.feature.querExperimentar} <Icon nome="arrow" class="go" /></a><a class="btn s" href="#como">{d.feature.comoFunciona}</a></div>
      </div>
      <div class="stage"><slot name="visual" /></div>
    </div>
  </section>

  <section class="sec" id="como" aria-labelledby="como-h">
    <div class="in">
      <h2 class="h2" id="como-h">{tituloPassos}</h2>
      <ol class={passosComoPerguntas ? 'how q' : 'how'} style="padding:0">
        {passos.map((p) => <li><h3>{p.titulo}</h3><p>{p.texto}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="sec alt" aria-labelledby="porque">
    <div class="in split">
      <div>
        <h2 class="h2" id="porque">{tituloBeneficios}</h2>
        <ul class="checks">
          {beneficios.map((b) => <li><Icon nome="check" forte /><div><b>{b.titulo}</b><span>{b.texto}</span></div></li>)}
        </ul>
      </div>
      <slot name="beneficios" />
    </div>
  </section>

  <section class="sec" aria-labelledby="rel">
    <div class="in">
      <h2 class="h2" id="rel" style="font-size:clamp(28px,3vw,38px)">{d.feature.relacionadas}</h2>
      <div class="related">
        {relacionadas.map((r) => <a class="hov" href={r.href}><Tile icone={r.icone} />{r.rotulo}</a>)}
      </div>
    </div>
  </section>

  {perguntas.length > 0 && (
    <section class="sec alt" aria-labelledby="pf">
      <div class="in">
        <h2 class="h2" id="pf" style="margin:0 auto;text-align:center;font-size:clamp(28px,3vw,38px)">{d.feature.perguntas}</h2>
        <Faq itens={perguntas} esquema />
      </div>
    </section>
  )}

  <FinalCta lang={lang} />
</Base>
