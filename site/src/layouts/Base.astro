---
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { marca } from '../config/brand';
import { htmlLang, type Lang } from '../i18n';
import { paginas, LINGUAS } from '../i18n/rotas';
import { parDe } from '../i18n/pares';

interface Props {
  /** Título da página (já com o nome da marca no fim, quando faz sentido). */
  titulo: string;
  descricao: string;
  /** Item do menu a assinalar como página atual. */
  atual?: 'funcionalidades' | 'para-quem' | 'precos' | 'perguntas' | null;
  /** Objetos JSON-LD específicos da página (cada um vira um <script>). */
  jsonld?: object[];
  /** Imagem de partilha (caminho absoluto no site, 1200×630). Opcional. */
  imagem?: string;
  /** Página que nunca deve ser indexada, mesmo com INDEXAR=true (ex.: 404). */
  noindex?: boolean;
  /** Língua da página: define o `lang` do <html>, o menu, o rodapé e o `hreflang`. */
  lang?: Lang;
}
const { titulo, descricao, atual = null, jsonld = [], imagem, noindex = false, lang = 'pt' } = Astro.props;

const caminho = Astro.url.pathname;
const abs = (p: string) => marca.siteUrl + p;
const canonico = abs(caminho);
// Imagem de partilha: /og/<caminho-com-hífens>.jpg (início = inicio.jpg), gerada por `npm run og`.
// Se não existir, usa /og/inicio.jpg.
const slugOg = caminho.split('/').filter(Boolean).join('-') || 'inicio';
const porOmissao = existsSync(join(process.cwd(), 'public', 'og', `${slugOg}.jpg`)) ? `/og/${slugOg}.jpg` : (lang === 'en' ? '/og/en.jpg' : '/og/inicio.jpg');
const imagemFinal = imagem ?? porOmissao;
// Texto alternativo da imagem: o H1 da página (tirado do conteúdo já desenhado); se não houver, o título.
const conteudo = await Astro.slots.render('default');
const h1 = (conteudo.match(/<h1[^>]*>([\s\S]*?)<\/h1>/) || [])[1];
const altOg = h1 ? h1.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/\s+/g, ' ').trim() : titulo;
const robots = !marca.indexar || noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ld = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');

// Página equivalente na outra língua: o seletor de língua e os hreflang levam sempre a ela
// (sem equivalente, como na 404, o seletor leva ao início da outra língua).
const outraLingua: Lang = lang === 'pt' ? 'en' : 'pt';
const par = await parDe(caminho);
const outra = par?.[outraLingua] ?? paginas.inicio[outraLingua];
const inicioLingua = paginas.inicio[lang];

const organizacao = { '@type': 'Organization', '@id': abs('/#organizacao'), name: marca.nome, url: abs('/'), logo: abs('/img/logo-192.png'), email: marca.email };
const site = { '@type': 'WebSite', '@id': abs(lang === 'pt' ? '/#site' : `${inicioLingua}#site`), url: abs(inicioLingua), name: marca.nome, inLanguage: htmlLang[lang], publisher: { '@id': abs('/#organizacao') } };
---
<!doctype html>
<html lang={htmlLang[lang]}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{titulo}</title>
<meta name="description" content={descricao}>
<meta name="robots" content={robots}>
{!noindex && <link rel="canonical" href={canonico} />}
{!noindex && (par
  ? LINGUAS.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(par[l])} />)
  : <link rel="alternate" hreflang={htmlLang[lang]} href={canonico} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={par ? abs(par.pt) : canonico} />}
<meta name="theme-color" content={marca.corTema}>
<link rel="icon" type="image/png" href="/img/logo-192.png">
<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content={marca.nome}>
<meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_GB'}>
{!noindex && par && <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_GB' : 'pt_PT'} />}
<meta property="og:title" content={titulo}>
<meta property="og:description" content={descricao}>
<meta property="og:url" content={canonico}>
<meta property="og:image" content={abs(imagemFinal)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={altOg} />
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={abs(imagemFinal)}>
<meta name="twitter:title" content={titulo}>
<meta name="twitter:description" content={descricao}>
<script type="application/ld+json" set:html={ld({ '@context': 'https://schema.org', '@graph': [organizacao, site] })} />
{jsonld.map((o) => <script type="application/ld+json" set:html={ld(o)} />)}
</head>
<body>
<Header atual={atual} lang={lang} outra={outra} />
<main id="conteudo" set:html={conteudo} />
<Footer lang={lang} outra={outra} />
</body>
</html>
