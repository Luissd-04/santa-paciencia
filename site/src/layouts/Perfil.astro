---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import PlanoRecomendado from '../components/PlanoRecomendado.astro';
import Icon, { type NomeIcone } from '../components/Icon.astro';
import Tile from '../components/Tile.astro';
import { t, type Lang } from '../i18n';
import { url } from '../i18n/rotas';

// Modelo das páginas «Para quem»: topo, secções de blocos, frase opcional, plano recomendado e chamada final.
interface Seccao { id: string; titulo: string; blocos: { icone: NomeIcone; titulo: string; texto: string }[]; frase?: string; colunas?: 3 }
interface Props {
  titulo: string; descricao: string; nome: string; h1: string; lede: string; fase?: number;
  seccoes: Seccao[];
  planoTitulo: string; planoTexto: string; planoIds: string[];
  fimTitulo: string; fimTexto: string;
  lang?: Lang;
}
const { lang = 'pt', titulo, descricao, nome, h1, lede, fase = 2.4, seccoes, planoTitulo, planoTexto, planoIds, fimTitulo, fimTexto } = Astro.props;
const d = t(lang).comum;
const caminho = [{ rotulo: d.inicio, href: url(lang, 'inicio') }, { rotulo: d.cab.paraQuem, href: url(lang, 'para') }, { rotulo: nome }];
---
<Base titulo={titulo} descricao={descricao} atual="para-quem" lang={lang}>
  <PageHero h1={h1} lede={lede} caminho={caminho} fase={fase} lang={lang}>
    <div class="ctas"><a class="btn p" href={url(lang, 'acesso')}>{d.perfil.querExperimentar} <Icon nome="arrow" class="go" /></a><a class="btn s" href="#plano">{d.perfil.verPlano}</a></div>
  </PageHero>

  {seccoes.map((s, i) => (
    <section class={i % 2 === 0 ? 'sec' : 'sec alt'} aria-labelledby={s.id}>
      <div class="in">
        <h2 class="h2" id={s.id}>{s.titulo}</h2>
        {s.blocos.length > 0 && (
          <div class={s.colunas === 3 ? 'blocos tres' : 'blocos'}>
            {s.blocos.map((b) => <div class="bloco"><Tile icone={b.icone} /><h3>{b.titulo}</h3><p>{b.texto}</p></div>)}
          </div>
        )}
        {s.frase && <p class="frase">{s.frase}</p>}
      </div>
    </section>
  ))}

  <section class={seccoes.length % 2 === 0 ? 'sec' : 'sec alt'} id="plano" aria-labelledby="plano-h">
    <div class="in">
      <h2 class="h2" id="plano-h">{planoTitulo}</h2>
      <p class="sub">{planoTexto}</p>
      <PlanoRecomendado ids={planoIds} lang={lang} />
    </div>
  </section>

  <FinalCta titulo={fimTitulo} texto={fimTexto} fase={3.4} lang={lang} />
</Base>
