---
import Feature from '../../layouts/Feature.astro';
import GlassNotice from '../../components/GlassNotice.astro';
import PhoneDay from '../../components/PhoneDay.astro';
import CartaoLista from '../../components/visuais/CartaoLista.astro';
import { t, comMarca, type Lang } from '../../i18n';
import { relacionadas } from '../../config/relacionadas';

// Equipa e tarefas (/funcionalidades/equipa-e-tarefas/ e /en/features/team-and-tasks/).
interface Props { lang: Lang }
const { lang } = Astro.props;
const { titulo, aviso, telemovel, funcoes, ...p } = t(lang).funcionalidades['equipa-e-tarefas'];
---
<Feature lang={lang} titulo={comMarca(titulo)} {...p} relacionadas={relacionadas(lang, 'calendario', 'despesas', 'pre-check-in')}>
  <div slot="visual" style="position:relative">
    <PhoneDay titulo={telemovel.titulo} sub={telemovel.sub} itens={telemovel.itens} plano lang={lang} />
    <GlassNotice pos="g1" atraso={700} titulo={aviso.titulo} texto={aviso.texto} />
  </div>
  <CartaoLista slot="beneficios" titulo={funcoes.titulo} etiqueta={funcoes.etiqueta} linhas={funcoes.linhas} />
</Feature>
