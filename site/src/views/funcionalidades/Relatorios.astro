---
import Feature from '../../layouts/Feature.astro';
import GlassNotice from '../../components/GlassNotice.astro';
import RelatorioBarras from '../../components/visuais/RelatorioBarras.astro';
import CanaisBarras from '../../components/visuais/CanaisBarras.astro';
import { t, comMarca, type Lang } from '../../i18n';
import { relacionadas } from '../../config/relacionadas';

// Relatórios (/funcionalidades/relatorios/ e /en/features/reports/). Os «passos» são perguntas.
interface Props { lang: Lang }
const { lang } = Astro.props;
const { titulo, aviso, ...p } = t(lang).funcionalidades.relatorios;
---
<Feature lang={lang} titulo={comMarca(titulo)} {...p} passosComoPerguntas relacionadas={relacionadas(lang, 'despesas', 'pagamentos-online', 'calendario')}>
  <div slot="visual" style="position:relative">
    <RelatorioBarras lang={lang} />
    <GlassNotice pos="g1" atraso={700} titulo={aviso.titulo} texto={aviso.texto} />
  </div>
  <CanaisBarras slot="beneficios" lang={lang} />
</Feature>
