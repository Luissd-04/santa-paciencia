---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import Faq from '../components/Faq.astro';
import { t, comMarca, type Lang } from '../i18n';
import { url } from '../i18n/rotas';

// Perguntas frequentes (/perguntas-frequentes/ e /en/faq/), por temas, com JSON-LD FAQPage.
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).perguntas;
const inicio = t(lang).comum.inicio;

const todas = d.temas.flatMap((tema) => tema.itens);
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: todas.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
}];
---
<Base titulo={comMarca(d.titulo)} descricao={d.descricao} atual="perguntas" jsonld={jsonld} lang={lang}>
  <PageHero h1={d.h1} lede={d.lede} fase={1.3} lang={lang}
    caminho={[{ rotulo: inicio, href: url(lang, 'inicio') }, { rotulo: d.caminho }]} />
  <section class="sec" style="padding-top:64px" aria-label={d.porTemaAria}>
    <div class="in" style="max-width:860px">
      <nav class="temas" aria-label={d.temasAria}>
        {d.temas.map((tema) => <a href={`#${tema.id}`}>{tema.titulo}</a>)}
      </nav>
      <div style="margin-top:24px">
        {d.temas.map((tema) => (
          <section class="tema" id={tema.id} aria-labelledby={`${tema.id}-h`}>
            <h2 id={`${tema.id}-h`}>{tema.titulo}</h2>
            <Faq itens={tema.itens} />
          </section>
        ))}
      </div>
    </div>
  </section>
  <FinalCta titulo={d.fimTitulo} texto={d.fimTexto} lang={lang} />
</Base>
