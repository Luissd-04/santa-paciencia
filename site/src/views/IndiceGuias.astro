---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FinalCta from '../components/FinalCta.astro';
import Icon from '../components/Icon.astro';
import { t, comMarca, type Lang } from '../i18n';
import { url, urlGuia } from '../i18n/rotas';
import { tempoLeitura, guiasDe, slugDe } from '../config/guias';

// Lista de guias (/guias/ e /en/guides/): só os da língua da página.
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).indiceGuias;
const guias = await guiasDe(lang);
---
<Base titulo={comMarca(d.titulo)} descricao={d.descricao} lang={lang}>
  <PageHero h1={d.h1} lede={d.lede} fase={5.0} lang={lang}
    caminho={[{ rotulo: t(lang).comum.inicio, href: url(lang, 'inicio') }, { rotulo: d.caminho }]} />
  <section class="sec" aria-label={d.guiasAria}>
    <div class="in">
      <div class="cartoes" style="margin-top:0">
        {guias.map((g) => (
          <a class="cartao" href={urlGuia(slugDe(g.id), lang)}>
            <small>{g.data.tema} · {tempoLeitura(g.body ?? '')} {d.leitura}</small>
            <h2>{g.data.titulo}</h2>
            <p>{g.data.resumo}</p>
            <span class="more">{d.ler} <Icon nome="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <FinalCta lang={lang} />
</Base>
