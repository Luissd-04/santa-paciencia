---
import Base from '../layouts/Base.astro';
import Calcada from '../components/Calcada.astro';
import Icon from '../components/Icon.astro';
import PlanToggle from '../components/PlanToggle.astro';
import PlanCards from '../components/PlanCards.astro';
import CompareTable from '../components/CompareTable.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { marca, planos } from '../config/brand';

const titulo = `Preços do software de alojamento local | ${marca.nome}`;
const descricao = `Planos a partir de ${planos[0].mensal} € por mês, sem comissões por reserva nem fidelização. Escolha pelo número de casas e experimente.`;

const perguntas: [string, string][] = [
  ['Há comissões por reserva?', 'Não. Paga só o plano. Nos pagamentos por cartão aplicam-se as taxas da Stripe, como em qualquer loja online.'],
  ['Posso mudar de plano?', 'Sempre que quiser, para cima ou para baixo.'],
  ['Há fidelização?', 'Não. No plano mensal pode cancelar quando quiser.'],
  ['Os preços incluem IVA?', 'Os valores apresentados não incluem IVA à taxa legal em vigor.'],
];

// Product com uma Offer por plano (preço mensal) + FAQPage (na própria <Faq>).
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'Product', name: marca.nome, description: 'Software de gestão de alojamento local.',
  brand: { '@type': 'Brand', name: marca.nome },
  offers: planos.map((p) => ({
    '@type': 'Offer', name: p.nome, price: p.mensal.toFixed(2), priceCurrency: 'EUR', url: marca.siteUrl + '/precos/',
    description: `${p.para} ${p.limites}.`, availability: 'https://schema.org/InStock',
    priceSpecification: { '@type': 'UnitPriceSpecification', price: p.mensal.toFixed(2), priceCurrency: 'EUR', billingDuration: 1, unitCode: 'MON' },
  })),
}];
---
<Base titulo={titulo} descricao={descricao} atual="precos" jsonld={jsonld}>
  <section class="dark">
    <Calcada fase={2.2} />
    <div class="in center" style="padding-top:80px;padding-bottom:230px">
      <h1 style="max-width:900px;margin:0 auto">Preços simples. Zero comissões.</h1>
      <p class="lede" style="margin-left:auto;margin-right:auto">Escolha pelo número de casas. Todas as reservas que fizer são suas, por inteiro.</p>
      <PlanToggle />
    </div>
  </section>

  <section class="sec" style="padding-top:0" aria-label="Planos">
    <div class="in">
      <PlanCards />
      <div class="nofee"><span><Icon nome="check" forte />Sem comissões por reserva</span><span><Icon nome="check" forte />Sem fidelização</span><span><Icon nome="check" forte />Ajuda na configuração</span></div>
      <h2 class="h2" style="margin-top:96px">Compare os planos</h2>
      <CompareTable />
    </div>
  </section>

  <section class="sec alt" aria-labelledby="ppf">
    <div class="in">
      <h2 class="h2" id="ppf" style="margin:0 auto;text-align:center">Perguntas sobre preços</h2>
      <Faq itens={perguntas} esquema />
    </div>
  </section>

  <FinalCta />
</Base>
