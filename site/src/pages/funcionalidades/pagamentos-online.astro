---
import Feature from '../../layouts/Feature.astro';
import GlassNotice from '../../components/GlassNotice.astro';
import PhoneDay from '../../components/PhoneDay.astro';
import { marca } from '../../config/brand';

const titulo = `Pagamentos online para alojamento local | ${marca.nome}`;
const descricao = 'Cobre o sinal e o saldo das reservas do seu alojamento local por cartão, sem transferências nem lembretes. Sem comissões por reserva.';

const passos = [
  { titulo: 'Chega a reserva', texto: 'Pelo seu site ou registada por si. O valor do sinal é calculado com as suas regras.' },
  { titulo: 'O hóspede paga', texto: 'Recebe um email com o link e paga por cartão, em segurança, com a Stripe.' },
  { titulo: 'Tudo se atualiza', texto: 'A reserva fica confirmada, o pagamento registado e o saldo agendado.' },
];
const beneficios = [
  { titulo: 'Sinal ou pagamento total', texto: 'Escolhe a percentagem e quando se cobra o resto.' },
  { titulo: 'Política de cancelamento clara', texto: 'O hóspede vê-a antes de pagar. Os reembolsos ficam registados.' },
  { titulo: 'Sem comissões por reserva', texto: 'Paga só as taxas do cartão, como em qualquer loja online.' },
  { titulo: 'Tudo no relatório do mês', texto: 'Cada pagamento fica ligado à reserva, à casa e ao canal.' },
];
const relacionadas = [
  { icone: 'web', rotulo: 'Reservas no seu site', href: '/funcionalidades/reservas-diretas/' },
  { icone: 'mail', rotulo: 'Emails automáticos', href: '/funcionalidades/mensagens-automaticas/' },
  { icone: 'chart', rotulo: 'Relatórios', href: '/funcionalidades/relatorios/' },
] as const;
const pagamentos = [
  { hora: '02 nov', titulo: 'Saldo · Casa da Eira', texto: '280,00 € cobrado' },
  { hora: '28 out', titulo: 'Sinal · Quarto Azul', texto: '54,00 € por cartão' },
  { hora: '27 out', titulo: 'Reembolso · Loft do Rio', texto: 'Cancelamento dentro do prazo' },
  { hora: '09 nov', titulo: 'Saldo · Monte Branco', texto: 'Agendado · 310,00 €', feito: false, destaque: true },
];
---
<Feature
  titulo={titulo} descricao={descricao} nome="Pagamentos online"
  h1="Receba o sinal sem ter de pedir duas vezes."
  lede="Pagamentos online para o seu alojamento local: o hóspede paga por cartão, a reserva confirma-se sozinha e o saldo é cobrado na data certa."
  passos={passos} tituloPassos="Três passos, e nenhum é seu."
  tituloBeneficios="Menos tempo no banco, mais noites vendidas." beneficios={beneficios}
  relacionadas={[...relacionadas]}
>
  <div slot="visual" class="paycard">
    <div class="hd"><b>Casa da Eira</b><span class="pill">Sinal · 30 %</span></div>
    <div class="amt">120,00 €</div><div style="color:var(--cinza);font-size:15px">Família Lopes · 9 a 12 de novembro</div>
    <div style="margin-top:18px"><div class="line"><span>Total da estadia</span><b>400,00 €</b></div><div class="line"><span>Saldo a 2 de novembro</span><b>280,00 €</b></div><div class="line"><span>Taxa turística</span><b>12,00 €</b></div></div>
    <a class="btn p" href="#como" style="width:100%;margin-top:18px">Pagar 120,00 €</a>
    <GlassNotice pos="g1" atraso={700} titulo="Pago por cartão" texto="Reserva confirmada" />
  </div>
  <PhoneDay slot="beneficios" titulo="Pagamentos" sub="novembro" itens={pagamentos} plano />
</Feature>
