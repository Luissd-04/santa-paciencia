---
import Feature from '../../layouts/Feature.astro';
import GlassNotice from '../../components/GlassNotice.astro';
import AppCalendar from '../../components/AppCalendar.astro';
import CartaoLista from '../../components/visuais/CartaoLista.astro';
import { marca } from '../../config/brand';
import { relacionadas } from '../../config/relacionadas';

const titulo = `Calendário de alojamento local com Airbnb | ${marca.nome}`;
const descricao = 'Todas as reservas do Airbnb, do Booking.com e do seu site num só calendário de alojamento local. Preços por época e nada de reservas duplicadas.';

const passos = [
  { titulo: 'Liga as plataformas', texto: 'Cola o link de calendário do Airbnb e do Booking.com. É só uma vez.' },
  { titulo: 'As reservas aparecem', texto: 'Cada uma com a cor do canal, na linha da casa certa.' },
  { titulo: 'As datas fecham-se em todo o lado', texto: 'O que vende num sítio deixa de estar livre nos outros.' },
];
const beneficios = [
  { titulo: 'Preços por época', texto: 'Verão, Páscoa, fins de semana: define uma vez e o total calcula-se sozinho.' },
  { titulo: 'Estadia mínima', texto: 'Nada de noites soltas a meio de agosto.' },
  { titulo: 'Arrastar para mudar', texto: 'Muda as datas e o preço acompanha.' },
  { titulo: 'Cada reserva com história', texto: 'Hóspede, valores, pagamentos e quem mudou o quê.' },
];
const epocas = [
  { t: 'Época baixa', s: '1 nov a 31 mar · mín. 2 noites', v: '70 € / noite' },
  { t: 'Primavera', s: '1 abr a 14 jun · mín. 2 noites', v: '95 € / noite' },
  { t: 'Verão', s: '15 jun a 15 set · mín. 4 noites', v: '140 € / noite' },
  { t: 'Fins de semana de verão', s: 'sex e sáb · mín. 3 noites', v: '160 € / noite' },
];
const perguntas: [string, string][] = [
  ['A sincronização é instantânea?', 'As plataformas atualizam os calendários de tempos a tempos; por isso, nas datas mais disputadas, convém confirmar antes de aceitar uma reserva por telefone.'],
  ['Posso bloquear datas para mim?', 'Pode. Os bloqueios aparecem no calendário e fecham as datas nas outras plataformas.'],
];
---
<Feature
  titulo={titulo} descricao={descricao} nome="Calendário"
  h1="Um calendário. Todas as reservas. Zero sobreposições."
  lede="O calendário do seu alojamento local junta o Airbnb, o Booking.com, o seu site e as reservas por telefone. Vê num relance quem entra, quem sai e que noites estão por vender."
  passos={passos} tituloPassos="Liga uma vez, o resto faz-se sozinho."
  tituloBeneficios="Preços certos, noites bem vendidas." beneficios={beneficios}
  relacionadas={relacionadas('reservas-diretas', 'pagamentos-online', 'equipa-e-tarefas')}
  perguntas={perguntas}
>
  <div slot="visual" role="img" aria-label="Calendário de reservas com avisos: nova reserva e datas fechadas no Airbnb">
    <AppCalendar />
    <GlassNotice pos="g1" atraso={700} titulo="Nova reserva" texto="Pelo seu site · Loft do Rio" />
    <GlassNotice pos="g2" atraso={1150} titulo="Datas fechadas" texto="Também no Airbnb e no Booking.com" />
  </div>
  <CartaoLista slot="beneficios" titulo="Preços · Casa da Eira" etiqueta="Por época" linhas={epocas} />
</Feature>
