---
import Base from '../../layouts/Base.astro';
import Calcada from '../../components/Calcada.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import Tile from '../../components/Tile.astro';
import FinalCta from '../../components/FinalCta.astro';
import { marca, funcionalidades, urlFuncionalidade } from '../../config/brand';
import '../../styles/visuais.css';

const titulo = `Funcionalidades do software de alojamento local | ${marca.nome}`;
const descricao = 'Calendário, reservas diretas, pagamentos, pré-check-in, limpezas, emails, despesas e relatórios. Tudo o que um alojamento local precisa, num só sítio.';

const caminho = [{ rotulo: 'Início', href: '/' }, { rotulo: 'Funcionalidades' }];
const ainda = [
  ['Funciona como app no telemóvel.', 'Adicione ao ecrã principal e receba avisos.'],
  ['Cópias de segurança.', 'Exporte os seus dados quando quiser.'],
  ['Registo de quem fez o quê.', 'Cancelamentos, reembolsos e permissões ficam registados.'],
  ['Ajuda dentro da app.', 'Fale connosco sem sair do sítio.'],
];
---
<Base titulo={titulo} descricao={descricao} atual="funcionalidades">
  <section class="dark play">
    <Calcada fase={1.2} />
    <div class="in" style="padding-top:72px;padding-bottom:230px">
      <Breadcrumbs itens={caminho} />
      <h1 style="max-width:900px">Tudo o que precisa. Nada do que não precisa.</h1>
      <p class="lede">Oito ferramentas que trabalham juntas. Comece pelas que lhe fazem falta hoje; as outras estão lá quando o negócio crescer.</p>
    </div>
  </section>

  <section class="sec" style="padding-top:0" aria-label="As oito funcionalidades">
    <div class="in">
      <div class="grid" style="margin-top:-110px;position:relative">
        {funcionalidades.map((f) => (
          <a class="f hov" href={urlFuncionalidade(f.slug)}><Tile icone={f.icone} /><h2 style="margin:6px 0 0;font:700 20px/1.2 var(--disp);letter-spacing:-.02em">{f.titulo}</h2><p>{f.texto}</p><span class="more">Saber mais <Icon nome="arrow" class="go" /></span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec alt" aria-labelledby="ainda">
    <div class="in">
      <h2 class="h2" id="ainda">E ainda</h2>
      <ul class="ainda">
        {ainda.map(([t, s]) => <li><Icon nome="check" forte /><div><b>{t}</b><span>{s}</span></div></li>)}
      </ul>
    </div>
  </section>

  <FinalCta />
</Base>
