---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import FinalCta from '../../components/FinalCta.astro';
import Icon from '../../components/Icon.astro';
import { marca } from '../../config/brand';
import { tempoLeitura } from '../../config/guias';

const titulo = `Guias de gestão de alojamento local | ${marca.nome}`;
const descricao = 'Guias práticos para quem tem alojamento local: organizar as reservas, definir sinal e cancelamento e preparar a chegada dos hóspedes.';
const guias = (await getCollection('guias')).sort((a, b) => b.data.publicado.getTime() - a.data.publicado.getTime());
---
<Base titulo={titulo} descricao={descricao}>
  <PageHero h1="Guias para quem tem alojamento local." lede="Conselhos práticos, sem rodeios, para receber melhor e trabalhar menos." fase={5.0}
    caminho={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Guias' }]} />
  <section class="sec" aria-label="Guias">
    <div class="in">
      <div class="cartoes" style="margin-top:0">
        {guias.map((g) => (
          <a class="cartao" href={`/guias/${g.id}/`}>
            <small>{g.data.tema} · {tempoLeitura(g.body ?? '')} min de leitura</small>
            <h2>{g.data.titulo}</h2>
            <p>{g.data.resumo}</p>
            <span class="more">Ler o guia <Icon nome="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <FinalCta />
</Base>
