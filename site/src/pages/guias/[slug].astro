---
import { guiasDe, slugDe } from '../../config/guias';
import Vista from '../../views/GuiaPagina.astro';

export async function getStaticPaths() {
  const guias = await guiasDe('pt');
  return guias.map((g) => ({ params: { slug: slugDe(g.id) }, props: { g, outros: guias.filter((o) => o.id !== g.id) } }));
}
const { g, outros } = Astro.props;
---
<Vista lang="pt" g={g} outros={outros} />
