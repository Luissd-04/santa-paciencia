---
import Base from '../layouts/Base.astro';
import Calcada from '../components/Calcada.astro';
import Icon, { type NomeIcone } from '../components/Icon.astro';
import Tile from '../components/Tile.astro';
import GlassNotice from '../components/GlassNotice.astro';
import AppCalendar from '../components/AppCalendar.astro';
import PhoneDay from '../components/PhoneDay.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { marca, funcionalidades, planos, urlFuncionalidade } from '../config/brand';

const titulo = `Software de gestão de alojamento local | ${marca.nome}`;
const descricao = 'Reservas, pagamentos, hóspedes e limpezas do seu alojamento local num só sítio. Sem comissões por reserva, feito em Portugal. Peça acesso antecipado.';

const dores = [
  ['22:47', '«Ainda tem vaga para o fim de semana?»', 'E lá vai abrir três calendários para ter a certeza.'],
  ['Sexta', 'Ninguém sabe se o sinal já entrou.', 'Procura no banco, no email e nas mensagens. Duas vezes.'],
  ['Sábado', 'A limpeza foi combinada por WhatsApp.', 'Às onze da noite, numa conversa que já ninguém encontra.'],
  ['Março', 'Os talões estão numa caixa de sapatos.', 'E o contabilista quer tudo até sexta-feira.'],
];

const passos = [
  ['09:12', 'Entra uma reserva pelo seu site', 'Sem intermediários e sem comissão. As datas ficam bloqueadas no calendário e, com a sincronização, também no Airbnb e no Booking.com.'],
  ['09:13', 'O hóspede paga o sinal', 'Recebe um link e paga por cartão. Não precisa de enviar o IBAN nem de confirmar transferências.'],
  ['3 dias antes', 'Chega o pré-check-in', 'O hóspede preenche os dados no telemóvel, já com o que precisa para o SIBA.'],
  ['Véspera', 'A Rita sabe o que limpar', 'A limpeza fica atribuída com hora marcada e aparece no telemóvel dela.'],
  ['Saída', 'As contas fazem-se sozinhas', 'O saldo é cobrado, a taxa turística fica calculada e o relatório do mês atualizado.'],
];

const hoje = [
  { hora: '09:12', titulo: 'Nova reserva · Loft do Rio', texto: '3 noites · pelo seu site' },
  { hora: '09:13', titulo: 'Sinal recebido', texto: '120,00 € por cartão' },
  { hora: '10:00', titulo: 'Limpeza · Casa da Eira', texto: 'Atribuída à Rita', feito: false, destaque: true },
  { hora: '15:30', titulo: 'Pré-check-in feito', texto: 'Família Lopes · 4 hóspedes' },
  { hora: '16:00', titulo: 'Chegada · Casa da Eira', texto: 'Instruções de chegada enviadas', feito: false },
];

const portugal: [NomeIcone, string, string][] = [
  ['receipt', 'Taxa turística calculada', 'Por noite e por hóspede, já nas reservas e nos relatórios.'],
  ['key', 'Dados para o SIBA', 'O pré-check-in recolhe tudo o que precisa para comunicar.'],
  ['book', 'Livro de Reclamações e registo AL', 'Sempre à vista na página de reservas e nos emails.'],
  ['flag', 'Português de Portugal', 'Nos ecrãs, nos emails e no apoio. Sem traduções à pressa.'],
  ['shield', 'RGPD tratado', 'O consentimento de cada hóspede fica registado com a reserva.'],
];

const quem = [
  ['1–3', 'Proprietários', 'Gere as casas nas horas vagas e quer deixar de viver agarrado ao telemóvel.', '/para/proprietarios/'],
  ['4–20', 'Gestores de várias casas', 'Precisa de ver tudo de uma vez: quem chega, quem pagou, o que falta limpar.', '/para/gestores/'],
  ['20+', 'Empresas de gestão', 'Equipas, permissões por função e relatórios para enviar a cada proprietário.', '/para/empresas-de-gestao/'],
];

const perguntas: [string, string][] = [
  ['Funciona com o Airbnb e o Booking.com?', 'Sim. As reservas dessas plataformas entram no mesmo calendário, e as datas que vende no seu site ficam bloqueadas lá. Assim não há reservas duplicadas.'],
  ['Preciso de instalar alguma coisa?', 'Não. Funciona no browser, no computador e no telemóvel. Se quiser, pode adicioná-lo ao ecrã principal do telemóvel como uma app.'],
  ['Quanto custa?', 'Há três planos mensais, consoante o número de casas, e nenhuma comissão por reserva. Pode ver tudo na página de preços.'],
  ['Comunica os hóspedes ao SIBA?', 'O pré-check-in recolhe todos os dados que o SIBA pede. A comunicação continua a ser feita por si, mas com os dados já organizados.'],
  ['Os meus dados estão seguros?', 'Sim. O acesso é protegido, cada pessoa da equipa vê só o que precisa e o consentimento dos hóspedes fica registado.'],
  ['Posso mudar a meio da época?', 'Pode. Ajudamos a passar as reservas que já tem, para não perder nada pelo caminho.'],
];

const jsonld = [{
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: marca.nome, applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web', inLanguage: marca.locale, url: marca.siteUrl + '/',
  description: 'Software de gestão de alojamento local: reservas, pagamentos online, pré-check-in, limpezas e relatórios.',
  offers: { '@type': 'Offer', price: String(planos[0].mensal), priceCurrency: 'EUR' },
}];
---
<Base titulo={titulo} descricao={descricao} jsonld={jsonld}>
  <section class="dark play" id="topo">
    <Calcada />
    <div class="in hero">
      <div>
        <span class="kicker"><b>Novo</b> Reservas no seu site, sem comissões</span>
        <h1>Alojamento local sem dores de cabeça.</h1>
        <p class="lede">Reservas, pagamentos, hóspedes e limpezas num só sítio. Menos telefonemas e folhas de cálculo, mais tempo para receber bem quem chega.</p>
        <div class="ctas"><a class="btn p" href="/acesso-antecipado/">Quero experimentar <Icon nome="arrow" class="go" /></a><a class="btn s" href="#um-dia">Ver um dia normal</a></div>
        <ul class="facts"><li><Icon nome="check" forte />Sem instalar nada</li><li><Icon nome="check" forte />Funciona no telemóvel</li><li><Icon nome="check" forte />Em português de Portugal</li></ul>
      </div>
      <div class="stage" role="img" aria-label="Calendário de reservas com avisos: nova reserva pelo site, sinal recebido e limpeza atribuída">
        <AppCalendar />
        <GlassNotice pos="g1" atraso={700} titulo="Nova reserva" texto="Pelo seu site · 0 € de comissão" />
        <GlassNotice pos="g2" atraso={1150} titulo="Sinal recebido" texto="Quarto Azul · 54,00 €" />
        <GlassNotice pos="g3" atraso={1600} titulo="Limpeza marcada" texto="Sábado, 10:00 · Rita" pop />
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="dores">
    <div class="in">
      <h2 class="h2" id="dores">Se tem alojamento local, já viveu isto.</h2>
      <div class="pains">
        {dores.map(([quando, p, small]) => <div class="pain"><span class="when">{quando}</span><div><p>{p}</p><small>{small}</small></div></div>)}
      </div>
      <div class="answer"><p>Nós também passámos por isso. Por isso juntámos tudo num só sítio.</p><a class="btn w" href="#um-dia">Ver como fica <Icon nome="arrow" class="go" /></a></div>
    </div>
  </section>

  <section class="sec alt" id="um-dia" aria-labelledby="dia">
    <div class="in">
      <h2 class="h2" id="dia">Um dia normal, sem correrias.</h2>
      <p class="sub">É isto que acontece enquanto está a tratar de outra coisa qualquer.</p>
      <div class="day">
        <ol class="steps">
          {passos.map(([t, h, p]) => <li><time>{t}</time><div><h3>{h}</h3><p>{p}</p></div></li>)}
        </ol>
        <PhoneDay titulo="Hoje" sub="qui, 12 nov" itens={hoje} />
      </div>
    </div>
  </section>

  <section class="sec" id="funcionalidades" aria-labelledby="tudo">
    <div class="in">
      <h2 class="h2" id="tudo">Tudo o que o seu alojamento precisa. Nada do que não precisa.</h2>
      <p class="sub">Oito ferramentas que falam umas com as outras: a reserva sabe do pagamento, a limpeza sabe da saída, o relatório sabe de tudo.</p>
      <div class="grid">
        {funcionalidades.map((f) => (
          <a class="f hov" href={urlFuncionalidade(f.slug)}><Tile icone={f.icone} /><h3>{f.titulo}</h3><p>{f.texto}</p><span class="more">Saber mais <Icon nome="arrow" class="go" /></span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="dark pt" aria-labelledby="pt">
    <Calcada fase={1.7} />
    <div class="in cols">
      <div>
        <h2 class="h2" id="pt">Feito em Portugal, para quem recebe em Portugal.</h2>
        <p class="sub">Os programas estrangeiros não sabem o que é a taxa turística de Lisboa nem o Livro de Reclamações. Este sabe.</p>
        <div class="ctas"><a class="btn p" href="/acesso-antecipado/">Quero experimentar <Icon nome="arrow" class="go" /></a></div>
      </div>
      <ul class="ptlist">
        {portugal.map(([i, b, s]) => <li><Icon nome={i} /><div><b>{b}</b><span>{s}</span></div></li>)}
      </ul>
    </div>
  </section>

  <section class="sec alt" id="para-quem" aria-labelledby="quem">
    <div class="in">
      <h2 class="h2" id="quem">Do primeiro quarto à empresa de gestão.</h2>
      <div class="who">
        {quem.map(([n, h, p, href]) => <a href={href}><span class="n">{n}</span><h3>{h}</h3><p>{p}</p></a>)}
      </div>
    </div>
  </section>

  <section class="sec" id="perguntas" aria-labelledby="pf">
    <div class="in">
      <h2 class="h2 center" id="pf" style="margin:0 auto;text-align:center">Perguntas que nos fazem sempre.</h2>
      <Faq itens={perguntas} esquema />
    </div>
  </section>

  <FinalCta />
</Base>
