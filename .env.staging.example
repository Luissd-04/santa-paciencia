# Configuração exclusiva de testes; não copiar os .env de produção.
# O ficheiro .env.staging é criado por scripts/staging.sh init, com modo 0600.
STAGING_PUBLIC_URL=https://testes.santapaciencia.xyz
PLATFORM_ADMIN_EMAILS=admin@testes.invalid
# O Compose fixa APP_ENV, DB_PATH, porta e desliga os serviços externos.
# O login usa HTTPS, através do hostname configurado no Cloudflare Tunnel.
